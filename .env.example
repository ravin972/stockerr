# =============================================================================
# Stockerr configuration  (NON-SECRET settings only)
# Copy this file to `.env` and edit. Secrets (API keys, tokens, passwords) do
# NOT go here — run `stockerr init` to store those in Windows Credential Manager.
# All values below are optional; sensible defaults are shown.
# =============================================================================

# --- Output locations ---------------------------------------------------------
STOCKERR_EXPORTS_DIR=exports
STOCKERR_STATE_DIR=state
STOCKERR_LOG_LEVEL=INFO

# --- Source mode --------------------------------------------------------------
# live = Binance API + Groww CSV | csv = Groww CSV only (ignores the Binance key)
STOCKERR_SOURCE_MODE=live

# --- Groww source (CSV route) -------------------------------------------------
# One or more paths to Groww holdings exports (stocks and/or mutual funds).
# Separate multiple files with a semicolon.
STOCKERR_GROWW_CSV=

# --- FX (crypto USD -> INR) ---------------------------------------------------
# frankfurter (ECB, free) | erapi (open.er-api.com, free) | manual
STOCKERR_FX_SOURCE=frankfurter
# If STOCKERR_FX_SOURCE=manual, set the rate here (e.g. 83.5):
STOCKERR_MANUAL_USD_INR=

# --- Alert thresholds ---------------------------------------------------------
# Category allocation must move more than this many percentage POINTS to alert.
STOCKERR_DRIFT_THRESHOLD_PP=5
# Any holding whose price moves more than this PERCENT since last run alerts.
STOCKERR_PRICE_MOVE_THRESHOLD_PCT=10
# Optional target allocation, e.g. "stock=50,mf=20,crypto=30" (drift measured vs this too).
STOCKERR_TARGET_ALLOCATION=

# --- Confidence Scoring Engine ------------------------------------------------
# Extra NSE symbols to score beyond your Groww holdings (comma separated), e.g. "TCS,INFY".
STOCKERR_SCORE_WATCHLIST=
# Screener.in export(s) with fundamentals (semicolon separated). Optional.
STOCKERR_SCREENER_CSV=
# Alert when a scored stock's confidence is at/above this (0-100). Blank = off.
STOCKERR_SCORE_ALERT_MIN=

# --- Discovery (opportunity screeners) ----------------------------------------
# Mutual funds to screen: AMFI scheme codes, comma separated (e.g. "120503,119597").
STOCKERR_MF_WATCHLIST=
# Crypto to screen: Binance USDT symbols, comma separated (e.g. "ETHUSDT,SOLUSDT").
STOCKERR_CRYPTO_WATCHLIST=
# Optional: AMFI categorization file (CSV/XLSX) for EXACT Large/Mid/Small cap tags.
# Download from amfiindia.com/otherdata/categorisation-of-stocks. Blank = market-cap thresholds.
STOCKERR_AMFI_CSV=

# --- Alert channels -----------------------------------------------------------
STOCKERR_TELEGRAM_ENABLED=false

STOCKERR_EMAIL_ENABLED=false
STOCKERR_EMAIL_SMTP_HOST=smtp.gmail.com
STOCKERR_EMAIL_SMTP_PORT=587
STOCKERR_EMAIL_FROM=
STOCKERR_EMAIL_TO=
