# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Keep LF for source/config, CRLF for Windows batch files.
*.py       text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.csv      text eol=lf
*.env*     text eol=lf
*.bat      text eol=crlf

# Binary assets (never diff/normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
